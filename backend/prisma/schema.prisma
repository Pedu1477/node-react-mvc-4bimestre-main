// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Aluno{
  id    Int     @id @default(autoincrement())
  nome  String  @db.VarChar(100)
  turma String  @db.VarChar(20)

  @@map("alunos")
}

model Usuario{
  id        String    @id @default(uuid()) @db.VarChar(36) 
  nome      String    @db.VarChar(100) 
  email     String    @unique @db.VarChar(191) 
  senhaHash String    @db.VarChar(255) 
  created   DateTime  @default(now()) 
  updated   DateTime  @updatedAt 

  @@map("usuarios")
}

model Relato {
  id        Int      @id @default(autoincrement())
  titulo    String   @db.VarChar(160)
  resumo    String   @db.VarChar(500)
  conteudo  String   @db.Text
  pessoa    String   @db.VarChar(120)
  local     String   @db.VarChar(100)
  periodo   String   @db.VarChar(80)
  categoria String   @db.VarChar(80)
  fontes    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("relatos")
}